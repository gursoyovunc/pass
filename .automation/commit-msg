#!/usr/bin/env bash

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

MAX_LENGTH=80

# Allowed conventional commit types
TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"

# Regex for Conventional Commits
# Allows optional scope and optional breaking change "!"
REGEX="^(${TYPES})(\\([a-zA-Z0-9._-]+\\))?(!)?: [a-z0-9].+[^.]$"

# Length check
if [ "${#COMMIT_MSG}" -gt "$MAX_LENGTH" ]; then
  echo "❌ Commit message is too long (${#COMMIT_MSG} chars). Max allowed is ${MAX_LENGTH}."
  exit 1
fi

# Ban WIP commits
if [[ "$COMMIT_MSG" =~ [Ww][Ii][Pp]|[Ww]ork[[:space:]]+[Ii]n[[:space:]]+[Pp]rogress ]]; then
  echo "❌ WIP commits are not allowed."
  echo "➡️  Please write a proper Conventional Commit message."
  exit 1
fi

# Conventional commit format + lowercase subject check
if ! [[ "$COMMIT_MSG" =~ $REGEX ]]; then
  echo "❌ Commit message does not follow Conventional Commits rules."
  echo
  echo "Rules:"
  echo "  • <type>(optional-scope)!: <lowercase subject>"
  echo "  • Subject must be lowercase"
  echo "  • Max length: 80 characters"
  echo
  echo "Allowed types:"
  echo "  feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo
  echo "Valid examples:"
  echo "  feat(api): add pagination support"
  echo "  feat!: drop legacy auth flow"
  echo "  fix(login): handle null token"
  exit 1
fi

exit 0